# BiasLens environment variables
# Copy this file to .env.local and fill in the values from your configured services.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase publishable / anon key (safe to expose in the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Public site URL (used for auth email redirect links). In production set to the live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: Airtable marketing pipeline integration
AIRTABLE_API_TOKEN=YOUR-AIRTABLE-PERSONAL-ACCESS-TOKEN
AIRTABLE_BASE_ID=appj4M2hNcwDx2yjd
AIRTABLE_ENQUIRIES_TABLE_ID=tblB1lF8cJsafECJR

# Server-only: Resend owner notification
RESEND_API_KEY=YOUR-RESEND-API-KEY
BIASLENS_NOTIFICATION_TO=hello@beaccessible.co.za
BIASLENS_NOTIFICATION_FROM=BiasLens <hello@beaccessible.co.za>
