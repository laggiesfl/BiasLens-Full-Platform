# BiasLens environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase publishable / anon key (safe to expose in the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Public site URL (used for auth email redirect links). In production set to your live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
